# Copy this file to .env (copy .env.example .env) and fill in your own values.
# .env stays on your PC: it is listed in .gitignore and is never uploaded. Never paste these values into a chat.

# Shopify app (Dev Dashboard → your app → Settings). Use the client ID + secret, or an Admin API token if your app has one.
SHOPIFY_STORE=0anyrv-ej.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=

# Gemini API key. Optional for website runs: photo choice and checks run on the Gemini website by default.
# Set CHECK_SOURCE=api to use the key for them instead (the free key allows only about 20 checks a day).
GEMINI_API_KEY=
# CHECK_SOURCE=web

# ---- Gemini website (optional; the defaults are fine) ----
# Where Chrome is, if it is not in the usual place
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Seconds to wait between website images
# WEB_SECONDS_BETWEEN_IMAGES=10
# Start a fresh shared check chat after this many checks
# WEB_CHECK_CHAT_MAX=40
# Your own daily limit of website images (0 = stop only when Gemini says the limit is reached)
# WEB_DAILY_CAP=0
# Smallest accepted short side in pixels
# WEB_MIN_SIDE=768
# Products per run
# MAX_PRODUCTS=25

# ---- Vertex AI (python run.py --vertex): uses your Google Cloud project and its free-trial credit ----
# No API key: sign in with "gcloud auth application-default login" (see README).
# GOOGLE_CLOUD_PROJECT=your-project-id
# The program stops before its estimated spend passes this many dollars
# VERTEX_BUDGET_USD=280

# ----- Google Drive upload (python drive_upload.py) -----
# OAuth client from Google Cloud (APIs & Services > Credentials > OAuth client ID > Desktop app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Printed by: python drive_upload.py --authorize (the client signs in with the Gmail that owns ABAYA PICTURE EDITED)
GOOGLE_OAUTH_REFRESH_TOKEN=
# The ABAYA PICTURE EDITED folder (the part after /folders/ in its link)
DRIVE_PARENT_FOLDER_ID=1rFNWDmDwLs8QpWnY7zvXN_jacqGWjYrR

# ----- Copy to LCM Pak (python copy_store.py) -----
# The LCM Pak store's address and the client ID + secret of the app made in LCM Pak's Dev Dashboard
TARGET_SHOPIFY_STORE=lcm-pak.myshopify.com
TARGET_SHOPIFY_CLIENT_ID=
TARGET_SHOPIFY_CLIENT_SECRET=
