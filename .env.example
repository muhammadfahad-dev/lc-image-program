# Copy this file to .env (copy .env.example .env) and fill in your own values.
# .env stays on your PC: it is listed in .gitignore and is never uploaded. Never paste these values into a chat.

# Shopify app (Dev Dashboard → your app → Settings). Use the client ID + secret, or an Admin API token if your app has one.
SHOPIFY_STORE=0anyrv-ej.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=

# Gemini API key (free). Used only for choosing the photo and checking images, not for making them.
GEMINI_API_KEY=

# ---- Gemini website (optional; the defaults are fine) ----
# Where Chrome is, if it is not in the usual place
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Seconds to wait between website images
# WEB_SECONDS_BETWEEN_IMAGES=30
# Your own daily limit of website images (0 = stop only when Gemini says the limit is reached)
# WEB_DAILY_CAP=0
# Smallest accepted short side in pixels
# WEB_MIN_SIDE=1000
# Products per run
# MAX_PRODUCTS=25
